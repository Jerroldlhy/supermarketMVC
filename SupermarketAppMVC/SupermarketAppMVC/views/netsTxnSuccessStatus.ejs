<%- include('partials/head', { title: 'NETS Payment Successful' }) %>
<%- include('partials/navbar', { user, activePage: 'orders' }) %>

<section class="page-section">
  <div class="container">
    <div class="card shadow-sm">
      <div class="card-body">
        <h2 class="mb-3">Payment successful</h2>
        <p class="text-muted"><%= message || 'Thank you for your payment!' %></p>
        <div class="d-flex flex-column flex-md-row gap-2">
          <% const orderLink = typeof orderId === 'number' ? `/orders/${orderId}/print` : '/orders/history'; %>
          <a href="<%= orderLink %>" class="btn btn-success">View receipt</a>
          <a href="/orders/history" class="btn btn-outline-secondary">Order history</a>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
