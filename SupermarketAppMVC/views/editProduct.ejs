<%- include('partials/head', { title: 'Edit Product | Supermarket App' }) %>
<%- include('partials/navbar', { user, activePage: 'inventory' }) %>

<div class="container py-4">
  <div class="text-center mb-4"><h2>Update Product</h2></div>
  <div class="text-center">
    <% if (product) { %>
      <form action="/editProduct/<%= product.id %>" method="POST" enctype="multipart/form-data" class="d-inline-block text-start">
        <label for="name" class="form-label">Product Name:</label>
        <input type="text" id="name" name="name" class="form-control mb-3" value="<%= product.productName %>" required>

        <label for="quantity" class="form-label">Quantity:</label>
        <input type="number" id="quantity" name="quantity" class="form-control mb-3" min="0" step="1" value="<%= product.quantity %>" required>

        <label for="price" class="form-label">Price:</label>
        <input type="number" id="price" name="price" class="form-control mb-3" min="0" step="0.01" value="<%= product.price %>" required>

        <label for="category" class="form-label">Section / Category:</label>
        <input type="text" id="category" name="category" class="form-control mb-3" value="<%= product.category || 'General' %>" required>

        <label for="image" class="form-label">Current Image:</label>
        <input type="text" name="currentImage" class="form-control mb-2" value="<%= product.image %>" readonly>
        <img src="/images/<%= product.image %>" alt="<%= product.productName %>" class="img-fluid mb-3" style="max-width: 200px;">

        <label for="image" class="form-label">New Image:</label>
        <input type="file" id="image" name="image" class="form-control mb-4" accept="image/*" value="<%= product.image %>">

        <button type="submit" class="btn btn-primary w-100">Update Product</button>
      </form>
    <% } else { %>
      <p>No product found.</p>
    <% } %>
    <a href="/" class="btn btn-link mt-3">Back</a>
  </div>
</div>

<%- include('partials/footer') %>
