<%- include('partials/head', { title: 'Inventory | Supermarket App' }) %>
<%- include('partials/navbar', { user, activePage: 'inventory' }) %>

<section class="page-section">
    <div class="container">
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
          <p class="mb-1 text-muted">Administrator dashboard</p>
          <h2 class="mb-0">Inventory overview</h2>
        </div>
        <div class="d-flex gap-2">
          <a href="/addProduct" class="btn btn-primary">Add new product</a>
          <a href="/admin/users" class="btn btn-secondary">Manage users</a>
        </div>
      </div>

      <div class="card shadow-sm mb-4">
        <div class="card-body d-flex flex-wrap gap-4 align-items-center">
          <div>
            <h5 class="text-muted mb-1">Signed in as</h5>
            <h4 class="mb-0"><%= user.username %> <span class="badge bg-primary text-uppercase ms-2"><%= user.role %></span></h4>
          </div>
          <div class="ms-md-auto">
            <span class="badge bg-light text-dark px-3 py-2">Total products: <strong><%= products.length %></strong></span>
          </div>
        </div>
      </div>

      <% if (messages && messages.length) { %>
        <% messages.forEach(function(message) { %>
          <div class="alert alert-success"><%= message %></div>
        <% }); %>
      <% } %>

      <% if (errors && errors.length) { %>
        <% errors.forEach(function(error) { %>
          <div class="alert alert-danger"><%= error %></div>
        <% }); %>
      <% } %>

      <div class="table-responsive">
        <table class="table table-modern align-middle">
          <thead class="text-uppercase small text-muted">
            <tr>
              <th scope="col">Product</th>
              <th scope="col">Section</th>
              <th scope="col">Image</th>
              <th scope="col">Quantity</th>
              <th scope="col">Price</th>
              <th scope="col">Offer</th>
              <th scope="col" class="text-center">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (products && products.length) { %>
              <% products.forEach(function(product) { %>
                <tr>
                  <td>
                    <a href="/product/<%= product.id %>" class="fw-semibold text-decoration-none"><%= product.productName %></a>
                  </td>
                  <td><span class="badge bg-dark-subtle text-dark"><%= product.category || 'General' %></span></td>
                  <td>
                    <% if (product.image) { %>
                      <img src="/images/<%= product.image %>" alt="<%= product.productName %>" class="img-thumbnail" style="width: 80px; height: 80px; object-fit: cover;">
                    <% } else { %>
                      <span class="text-muted">No image</span>
                    <% } %>
                  </td>
                  <td><span class="badge bg-light text-dark px-3 py-2"><%= product.quantity %></span></td>
                  <td>
                    <% if (product.hasDiscount) { %>
                      <div class="d-flex flex-column">
                        <span class="text-muted text-decoration-line-through">$<%= Number(product.price).toFixed(2) %></span>
                        <span class="fw-semibold">$<%= Number(product.effectivePrice).toFixed(2) %></span>
                        <span class="badge bg-success-subtle text-success"><%= Number(product.discountPercentage).toFixed(2) %>% off</span>
                      </div>
                    <% } else { %>
                      $<%= Number(product.price).toFixed(2) %>
                    <% } %>
                  </td>
                  <td>
                    <% if (product.offerMessage) { %>
                      <span class="text-muted"><%= product.offerMessage %></span>
                    <% } else { %>
                      <span class="text-muted">-</span>
                    <% } %>
                  </td>
                  <td class="text-center">
                    <div class="d-flex justify-content-center gap-2">
                      <a href="/updateProduct/<%= product.id %>" class="btn btn-outline-primary btn-sm">Edit</a>
                      <a href="/deleteProduct/<%= product.id %>" class="btn btn-outline-danger btn-sm" onclick="return confirm('Are you sure you want to delete this product?')">Delete</a>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="7">
                  <div class="empty-state">No products available. Add your first product to get started.</div>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  

<%- include('partials/footer') %>

