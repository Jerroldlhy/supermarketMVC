<%- include('partials/head', { title: 'Manage Users | Supermarket App' }) %>
<%- include('partials/navbar', { user, activePage: 'users' }) %>

<section class="page-section">
    <div class="container">
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
          <p class="mb-1 text-muted">Administrator dashboard</p>
          <h2 class="mb-0">User management</h2>
        </div>
        <span class="badge bg-light text-dark px-3 py-2">Total users: <strong><%= users ? users.length : 0 %></strong></span>
      </div>

      <% if (messages && messages.length) { %>
        <% messages.forEach(function(message) { %>
          <div class="alert alert-success"><%= message %></div>
        <% }); %>
      <% } %>

      <% if (errors && errors.length) { %>
        <% errors.forEach(function(error) { %>
          <div class="alert alert-danger"><%= error %></div>
        <% }); %>
      <% } %>

      <div class="table-responsive">
        <table class="table table-modern align-middle">
          <thead class="text-uppercase small text-muted">
            <tr>
              <th scope="col">ID</th>
              <th scope="col">Username</th>
              <th scope="col">Email</th>
              <th scope="col">Role</th>
              <th scope="col">Free Delivery</th>
              <th scope="col">Status</th>
              <th scope="col">Contact</th>
              <th scope="col">Address</th>
              <th scope="col" class="text-center">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (users && users.length) { %>
              <% users.forEach(function(u) { %>
                <tr>
                  <td>#<%= u.id %></td>
                  <td class="fw-semibold"><%= u.username %></td>
                  <td><%= u.email %></td>
                  <td><span class="badge bg-primary text-uppercase"><%= u.role %></span></td>
                  <td>
                    <% if (u.free_delivery) { %>
                      <span class="badge bg-success-subtle text-success">Enabled</span>
                    <% } else { %>
                      <span class="badge bg-light text-muted">Disabled</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (u.is_disabled) { %>
                      <span class="badge bg-danger-subtle text-danger">Disabled</span>
                    <% } else { %>
                      <span class="badge bg-success-subtle text-success">Active</span>
                    <% } %>
                  </td>
                  <td><%= u.contact || '-' %></td>
                  <td><%= u.address || '-' %></td>
                  <td class="text-center">
                    <div class="d-flex justify-content-center gap-2">
                      <a class="btn btn-outline-primary btn-sm" href="/admin/users/<%= u.id %>/edit">Edit role</a>
                      <form action="/admin/users/<%= u.id %>/delete" method="POST" onsubmit="return confirm(<%- JSON.stringify((u.is_disabled ? 'Enable ' : 'Disable ') + u.username + '?') %>);">
                        <button type="submit" class="btn btn-outline-<%= u.is_disabled ? 'success' : 'danger' %> btn-sm" <%= user && user.id === u.id ? 'disabled title=\"You cannot disable your own account.\"' : '' %>>
                          <%= u.is_disabled ? 'Enable' : 'Disable' %>
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="8">
                  <div class="empty-state">No users found. Invite your team or start registering shoppers.</div>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  

<%- include('partials/footer') %>

