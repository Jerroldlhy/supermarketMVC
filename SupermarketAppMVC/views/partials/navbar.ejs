<% const isAdmin = user && user.role === 'admin'; %>
<% const isUser = user && user.role === 'user'; %>
<% const navId = (typeof navbarId !== 'undefined' && navbarId !== null) ? navbarId : 'navbarMain'; %>
<% const currentActive = (typeof activePage !== 'undefined' && activePage !== null) ? activePage : ''; %>

<nav class="navbar navbar-expand-lg bg-dark navbar-dark">
  <div class="container-fluid">
    <a class="navbar-brand" href="/">Supermarket App</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#<%= navId %>">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="<%= navId %>">
      <ul class="navbar-nav ms-auto">
        <% if (!user) { %>
          <li class="nav-item">
            <a class="nav-link <%= currentActive === 'register' ? 'active' : '' %>" href="/register">Register</a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= currentActive === 'login' ? 'active' : '' %>" href="/login">Login</a>
          </li>
        <% } else if (isAdmin) { %>
          <li class="nav-item">
            <a class="nav-link <%= currentActive === 'inventory' ? 'active' : '' %>" href="/inventory">Inventory</a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= currentActive === 'addProduct' ? 'active' : '' %>" href="/addProduct">Add Product</a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= currentActive === 'users' ? 'active' : '' %>" href="/admin/users">Manage Users</a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= currentActive === 'deliveries' ? 'active' : '' %>" href="/admin/deliveries">Deliveries</a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= currentActive === '2fa' ? 'active' : '' %>" href="/2fa/setup">Security / 2FA</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/logout">Logout</a>
          </li>
        <% } else if (isUser) { %>
          <li class="nav-item">
            <a class="nav-link <%= currentActive === 'shopping' ? 'active' : '' %>" href="/shopping">Shop</a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= currentActive === 'cart' ? 'active' : '' %>" href="/cart">View Cart</a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= currentActive === 'orders' ? 'active' : '' %>" href="/orders/history">Purchase History</a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= currentActive === '2fa' ? 'active' : '' %>" href="/2fa/setup">Security / 2FA</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/logout">Logout</a>
          </li>
        <% } else { %>
          <li class="nav-item">
            <a class="nav-link" href="/logout">Logout</a>
          </li>
        <% } %>
      </ul>
    </div>
  </div>
</nav>
